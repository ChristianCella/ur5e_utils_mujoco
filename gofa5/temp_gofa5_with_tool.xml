<mujoco>
  <compiler autolimits="true" balanceinertia="true" meshdir="assets" angle="radian" coordinate="local"/>
  <option integrator="implicitfast"/>
  <option gravity="0 0 0"/>
  <size memory="2M"/>
  
  <visual>
    <global azimuth="120" elevation="-20"/> 
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>
  
  <default>
    <default class="Gofa/">
      <material specular="0.5" shininess="0.25"/>
      <default class="ur5e/type_joint1">
        <joint range="-3.1415000000000002 3.1415000000000002"/>
        <general ctrlrange="-3.1415000000000002 3.1415000000000002"/>
      </default>
      <default class="Gofa/visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="Gofa/collision">
        <geom type="mesh" group="3" rgba="0.7 0.1 0.1 0.3" contype="1" conaffinity="1"/>
        <default class="Gofa/eef_collision">
          <geom type="cylinder" group="3" rgba="0.7 0.1 0.1 0.3" contype="1" conaffinity="1"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="Gofa/white" class="Gofa/" rgba="1 1 1 1"/>
    <material name="Gofa/grey" class="Gofa/" rgba="0.27800000000000002 0.27800000000000002 0.27800000000000002 1"/>
    <mesh name="Gofa/base" class="Gofa/" file="base_link.stl" scale="1 1 1"/>
    <mesh name="Gofa/link1" class="Gofa/" file="link_1.stl" scale="1 1 1"/>
    <mesh name="Gofa/link2" class="Gofa/" file="link_2.stl" scale="1 1 1"/>
    <mesh name="Gofa/link3" class="Gofa/" file="link_3.stl" scale="1 1 1"/>
    <mesh name="Gofa/link4" class="Gofa/" file="link_4.stl" scale="1 1 1"/>
    <mesh name="Gofa/link5" class="Gofa/" file="link_5.stl" scale="1 1 1"/>
    <mesh name="Gofa/link6" class="Gofa/" file="link_6.stl" scale="1 1 1"/>
  <mesh name="tool_mesh" file="welding_gun.obj"/> 
    <!-- Welding gun collision mesh -->
    <mesh name="welding_gun_collision_mesh" file="welding_gun.obj"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <body name="Gofa/Robot">
      <body name="base" pos="0 0 0">
        <inertial pos="-0.0012013793465437 -0.000175191786981708 0.0862146007385352" euler="0 0 0" mass="3.50083457958494" diaginertia="0.0153015257917955 0.0159333503953857 0.0112162302268266"/>
        <geom name="Gofa/geom_base_visual" class="Gofa/visual" material="Gofa/grey" mesh="Gofa/base"/>
        <geom name="Gofa/geom_base_collision" class="Gofa/collision" mesh="Gofa/base"/>

        <body name="link_1" pos="0 0 0.1875" euler="0 0 0">
          <inertial pos="2.08682453325091e-6 0.0103608399967513 0.0705307203199506" euler="0 0 0" mass="2.76743491139404" diaginertia="0.0115158625894577 0.006494848329231 0.0109446835358581"/>
          <joint name="joint_1" class="ur5e/type_joint1" axis="0 0 1"/>
          <geom name="Gofa/geom_link1_visual" class="Gofa/visual" material="Gofa/grey" mesh="Gofa/link1"/>
          <geom name="Gofa/geom_link1_collision" class="Gofa/collision" mesh="Gofa/link1"/>

          <body name="link_2" pos="0 -0.085 0.0775" euler="0 0 0">
            <inertial pos="1.34018352211628E-06 -0.0500118376116071 0.222001399322246" euler="0 0 0" mass="4.28904168670464" diaginertia="0.130524729873898 0.133278449324229 0.00669457974697178"/>
            <joint name="joint_2" class="ur5e/type_joint1" axis="0 1 0"/>
            <geom name="Gofa/geom_link2_visual" class="Gofa/visual" material="Gofa/grey" mesh="Gofa/link2"/>
            <geom name="Gofa/geom_link2_collision" class="Gofa/collision" mesh="Gofa/link2"/>

            <body name="link_3" pos="0 -0.00100000000000007 0.444" euler="0 0 0">
              <inertial pos="0.0128129281453599 0.0944171780907046 0.0247427540642403" euler="0 0 0" mass="3.38333107992875" diaginertia="0.0175626138728642 0.0140230068919562 0.013275205067567"/>
              <joint name="joint_3" range="-3.926990817 1.4835298642" axis="0 1 0"/>
              <geom name="Gofa/geom_link3_visual" class="Gofa/visual" material="Gofa/grey" mesh="Gofa/link3"/>
              <geom name="Gofa/geom_link3_collision" class="Gofa/collision" mesh="Gofa/link3"/>

              <body name="link_4" pos="0.096 0.0860000000000001 0.11" euler="0 0 0">
                <inertial pos="0.160558561602322 0.041976811408979 -2.36623354021859E-07" euler="0 0 0" mass="2.77857535641324" diaginertia="0.00881683095901354 0.0340754175571832 0.0389358932156922"/>
                <joint name="joint_4" class="ur5e/type_joint1" axis="1 0 0"/>
                <geom name="Gofa/geom_link4_visual" class="Gofa/visual" material="Gofa/white" mesh="Gofa/link4"/>
                <geom name="Gofa/geom_link4_collision" class="Gofa/collision" mesh="Gofa/link4"/>

                <body name="link_5" pos="0.374 0.0744999999999998 0" euler="0 0 0">
                  <inertial pos="-0.0147152361879962 -0.0785646469392633 0.0427558021601431" euler="0 0 0" mass="3.01105814739001" diaginertia="0.0114597336686444 0.013561904467501 0.0108480119549914"/>
                  <joint name="joint_5" class="ur5e/type_joint1" axis="0 1 0"/>
                  <geom name="Gofa/geom_link5_visual" class="Gofa/visual" material="Gofa/white" mesh="Gofa/link5"/>
                  <geom name="Gofa/geom_link5_collision" class="Gofa/collision" mesh="Gofa/link5"/>

                  <body name="link_6" pos="0.0679999999999995 -0.0744999999999998 0.0800000000000003" euler="0 0 0">
                    <inertial pos="0.0137506852604966 0.000239804131398652 -0.000341962798940165" euler="0 0 0" mass="0.146500988015653" diaginertia="0.000128977630055306 0 7.65022909768016e-5"/>
                    <joint name="joint_6" range="-4.7123889804 4.7123889804" axis="1 0 0"/>
                    <geom name="Gofa/geom_link6_visual" class="Gofa/visual" rgba="0.6 0.6 0.6 1" mesh="Gofa/link6"/>
                    <geom name="Gofa/geom_link6_collision" class="Gofa/collision" mesh="Gofa/link6"/>

                    <site name="ee_site" pos="0.0326 0 0" quat="0.7071 0 0.7071 0"/>
                    <body name="ee_frame_visual_only" pos="0.0326 0 0" quat="0.7071 0 0.7071 0">
                      <geom type="capsule" fromto="0 0 0 0.05 0 0" rgba="1 0 0 1" size="0.002" contype="0" conaffinity="0"/>
                      <geom type="capsule" fromto="0 0 0 0 0.05 0" rgba="0 1 0 1" size="0.002" contype="0" conaffinity="0"/>
                      <geom type="capsule" fromto="0 0 0 0 0 0.05" rgba="0 0 1 1" size="0.002" contype="0" conaffinity="0"/>

                      <!-- Reference frame attached @ tool tip -->
                      <body name="tool_frame" pos="0 0 0" quat="1 0 0 0">
                        <site name="tool_site" pos="0 0 0" quat="1 0 0 0"/>
                        <geom type="capsule" fromto="0 0 0 0.06 0 0" rgba="1 0 0 1" size="0.003" contype="0" conaffinity="0"/>
                        <geom type="capsule" fromto="0 0 0 0 0.06 0" rgba="0 1 0 1" size="0.003" contype="0" conaffinity="0"/>
                        <geom type="capsule" fromto="0 0 0 0 0 0.06" rgba="0 0 1 1" size="0.003" contype="0" conaffinity="0"/>
                      </body>
                    <body name="tool_base" pos="0 0 0">
      <inertial mass="0.752" pos="0 -0.070 0.028" diaginertia="0.0143 0.0143 0.0016"/> 
      <!-- <inertial mass="0.0" pos="0 0.0 0.0" diaginertia="0.0 0.0 0.0"/> -->
      <!-- <inertial mass="0.95" pos="-0.003 -0.0375 0.013" diaginertia="0.0143 0.0143 0.0016"/> -->
      <geom type="mesh" mesh="tool_mesh" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0" group="0"/>
      <!-- collision cylinder -->
      <geom name="welding_gun_collision" type="mesh" mesh="welding_gun_collision_mesh" pos="0 0 0.0" rgba="0.7 0.1 0.1 0.3" contype="1" conaffinity="1" group="3"/>
      <!-- Marker (red sphere) to specify the origin -->
      <site name="mount_site" pos="0 0 0" size="0.005" rgba="1 0 0 1"/>
      <!-- Marker (green sphere) to specify the point of application of the weight -->
      <!-- <geom type="sphere" size="0.005" pos="0 -0.070 0.028" rgba="0 1 0 1" contype="0" conaffinity="0" group="2"/> -->
    </body>
  </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="joint_1" gear="1"/>
    <motor joint="joint_2" gear="1"/>
    <motor joint="joint_3" gear="1"/>
    <motor joint="joint_4" gear="1"/>
    <motor joint="joint_5" gear="1"/>
    <motor joint="joint_6" gear="1"/>
  </actuator>

</mujoco>
