<mujoco model="hande_gripper">
  <compiler angle="radian"/>
  <option timestep="0.01"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <mesh name="hande_mesh" file="cad_components/hande_gripper.stl"/> 
  </asset>

  <default>
    <geom condim="3" friction="1 0.5 0.01" solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </default>

  <worldbody>
    <body name="hande_base" pos="0 0 0">
      <inertial mass="2.6" pos="0 0 0.155" diaginertia="0.0143 0.0143 0.0016"/>
      
      <!-- Use STL mesh for visuals and collisions -->
      <geom type="mesh" mesh="hande_mesh"
            rgba="0.2 0.2 0.2 1"
            contype="1" conaffinity="1"
            group="0"/>

      <!-- Reference frame associated to the base of the tool -->
      <body name="gripper_base" pos="0 0 0.0" quat="1 0 0 0">
        <site name="gripper_base_site" pos="0 0.0 0" quat="1 0 0 0"/>
        <geom type="capsule" fromto="0 0 0 0.06 0 0" rgba="1 0 0 1" size="0.003" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0 0 0.06 0" rgba="0 1 0 1" size="0.003" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.06" rgba="0 0 1 1" size="0.003" contype="0" conaffinity="0"/>
      </body>

      <!-- Reference frame associated to the tip of the tool -->
      <body name="gripper_tip" pos="0 0 0.15" quat="1 0 0 0">
        <site name="gripper_tip_site" pos="0 0.0 0.15" quat="1 0 0 0"/>
        <geom type="capsule" fromto="0 0 0 0.06 0 0" rgba="1 0 0 1" size="0.003" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0 0 0.06 0" rgba="0 1 0 1" size="0.003" contype="0" conaffinity="0"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.06" rgba="0 0 1 1" size="0.003" contype="0" conaffinity="0"/>
      </body>
  
    </body>
  </worldbody>
</mujoco>
